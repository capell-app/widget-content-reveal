{
    "manifest-version": 3,
    "name": "capell-app/widget-content-reveal",
    "slug": "widget-content-reveal",
    "displayName": "Content Reveal Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "description": "Teaser cards reveal registered widget snapshots through accessible overlays, inline regions, or replacement regions.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetContentReveal",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetContentReveal\\Providers\\WidgetContentRevealServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.content-reveal",
            "class": "Capell\\WidgetContentReveal\\WidgetContentRevealContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-content-reveal",
            "class": "Capell\\WidgetContentReveal\\WidgetContentRevealContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static", "frontend.interactive"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-content-reveal"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-content-reveal.package-health",
            "label": "Content Reveal widget package health",
            "class": "Capell\\WidgetContentReveal\\Health\\WidgetContentRevealHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Reveal registered widgets through secure, accessible lazy interactions.",
        "description": "Introduce deeper content with up to twelve teaser cards that open another widget from the same page in a modal, slide-over, inline region or replacement region. Requires Layout Builder. Limits: the target widget must be present on the same rendered page; when it is not, the card keeps its teaser and button but cannot open it.",
        "problem": "Editors who want to offer more detail can send visitors away from the page to find it.",
        "outcome": "A page has teasers that reveal registered widget content in place.",
        "faq": [
            {
                "question": "Where can revealed content appear?",
                "answer": "Editors can choose modal, slide-over, inline or replacement presentation."
            },
            {
                "question": "Which content can a teaser open?",
                "answer": "A teaser connects to another registered widget; targets stay within the widget registry."
            },
            {
                "question": "How many reveal cards are allowed?",
                "answer": "A reveal must contain between 1 and 12 cards."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-content-reveal-public-output.png",
                "alt": "Content Reveal public output",
                "caption": "Content Reveal public output"
            },
            {
                "path": "docs/assets/marketplace/listing-content-reveal-layout-builder-editor.png",
                "alt": "Content Reveal fields in Layout Builder",
                "caption": "Content Reveal fields in Layout Builder"
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Content Reveal widget preview",
                "caption": "Content Reveal widget"
            }
        ],
        "categories": ["foundation", "frontend", "interactive"]
    }
}
