{
    "manifest-version": 3,
    "name": "capell-app/widget-content-reveal",
    "slug": "widget-content-reveal",
    "displayName": "Content Reveal Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.x-dev",
    "description": "Teaser cards reveal registered widget snapshots through accessible overlays, inline regions, or replacement regions.",
    "product": {
        "group": "Capell Foundation",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetContentReveal",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetContentReveal\\Providers\\WidgetContentRevealServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.content-reveal",
            "class": "Capell\\WidgetContentReveal\\WidgetContentRevealContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend.public-static", "frontend.interactive"],
    "security": {
        "riskTier": "medium",
        "publicSurface": {
            "routeNames": [
                "capell.widgets.snapshot.html",
                "capell.widgets.snapshot.json"
            ],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [
                "capell.widgets.snapshot.html",
                "capell.widgets.snapshot.json"
            ],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": { "authorization": "panel-auth", "permissions": [] }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-content-reveal"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-content-reveal.package-health",
            "label": "Content Reveal widget package health",
            "class": "Capell\\WidgetContentReveal\\Health\\WidgetContentRevealHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Reveal registered widgets through secure, accessible lazy interactions.",
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Content Reveal widget preview",
                "caption": "Content Reveal widget"
            }
        ],
        "categories": ["foundation", "frontend", "interactive"]
    }
}
